# Backend (server/). Copy to .env and edit. Never commit the real file.
PORT=8787
# Long random string used to sign player tokens. REQUIRED in production.
AUTH_SECRET=change-me-to-a-long-random-string
# Set to 1 to refuse websocket players without a valid token.
REQUIRE_AUTH=0
# Comma-separated origins allowed to call the HTTP API from a browser.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3100
# Postgres connection string (Supabase: Project Settings > Database > Connection string > Session pooler).
# Leave empty in development: the server then uses a local in-process Postgres in server/data/pgdata.
# DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-eu-west-1.pooler.supabase.com:5432/postgres

# Frontend: where the browser finds the backend (defaults to the same host, port 8787).
# NEXT_PUBLIC_WS_URL=ws://localhost:8787
# NEXT_PUBLIC_API_URL=http://localhost:8787
# Admin token for reviewing uploaded tracks (required in production).
ADMIN_TOKEN=change-me-too
# Artist music files: Supabase Storage (private bucket) in production, a local folder otherwise.
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_KEY=service_role key (server only, never in the browser)
# SUPABASE_BUCKET=tracks
# TRACKS_DIR=./server/data/tracks
# Set to 1 ONLY if you hold written permission to stream the intro song (server/data/intro/intro.mp3).
INTRO_LICENSED=0

# Email codes for sign up and log in. Without SMTP_URL the code is only printed to the server log (and returned to the browser in development).
# SMTP_URL=smtps://user:password@smtp.example.com:465
# MAIL_FROM=Omo Ibadan <no-reply@yourdomain.com>

# Voice through LiveKit Cloud (free tier). Without these, voice is peer-to-peer.
# LIVEKIT_URL=wss://your-project.livekit.cloud
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=

# Voice relay (coturn with use-auth-secret). Optional; without it voice uses public STUN only.
# TURN_URLS=turn:turn.yourdomain.com:3478,turns:turn.yourdomain.com:5349
# TURN_SECRET=the-coturn-static-auth-secret

# Demo mode is the default: sign up and log in happen in the browser only (no server, no email code).
# Set to 1 to use the real server accounts with emailed codes.
# NEXT_PUBLIC_REQUIRE_BACKEND=1
# Set 0 to skip emailed codes (sign up just collects name + email). Default 1.
# EMAIL_CODES=1
